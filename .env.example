# --- Exa (required for research) ---------------------------------------------
# Create a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
EXA_REQUESTS_PER_SECOND=4
EXA_LIMITER_DATABASE_URL=
EXA_MAX_RETRIES=5
# Hard ceiling (USD) for one `build` invocation; calls that would exceed it are refused.
EXA_RUN_BUDGET_USD=15
# Lifetime ceiling (USD) across all runs recorded in var/exa_cache.sqlite3.
EXA_TOTAL_BUDGET_USD=45
# Exa Agent effort; `auto` honours EXA_AGENT_MAX_COST_USD as a hard per-run cap (min $1).
EXA_AGENT_EFFORT=auto
EXA_AGENT_MAX_COST_USD=2
EXA_AGENT_TIMEOUT_S=1800
CACHE_TTL_HOURS=168

# --- Graph storage ---------------------------------------------------------------
# neo4j (recommended) or sqlite (embedded, zero-setup)
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Incremental refresh: stage freshness windows (days) --------------------------
TTL_DEMOCRACY_DAYS=180
TTL_CONTACT_DAYS=180
TTL_STRUCTURE_DAYS=90
TTL_OFFICEHOLDERS_DAYS=7

# --- Eligibility policy ---------------------------------------------------------
DEMOCRACY_ACCEPTED_FREEDOM_HOUSE=free
DEMOCRACY_ACCEPTED_VDEM=liberal_democracy,electoral_democracy
DEMOCRACY_ACCEPTED_EIU=full_democracy,flawed_democracy
DEMOCRACY_MIN_SOURCES=2
DEMOCRACY_MAX_AGE_YEARS=3
# `unknown` can never pass, even if listed here.
CONTACT_ACCEPTED_STATUSES=allowed
CONTACT_RELEVANT_PURPOSES=issue_communication,fact_verification_request
CONTACT_RELEVANT_SENDERS=organization
REQUIRE_HUMAN_REVIEW=true

# --- Verification -----------------------------------------------------------------
MIN_INDEPENDENT_DOMAINS=2
CORROBORATION_SEARCH=true

# --- Server / logging --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --- System B (social claims) ---------------------------------------------------
ORIANE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PAST_DEV_API_KEY=
PAST_DEV_BASE_URL=https://api.past.dev/api/v1
RATE_LIMITER_DATABASE_URL=
ANTHROPIC_REQUESTS_PER_SECOND=2
ORIANE_REQUESTS_PER_SECOND=1
PASTDEV_REQUESTS_PER_SECOND=2
CLAIM_SKIP_ANY_VERSION=false
# Where `make sc-pull` writes the claims export that /api/claims serves (git-ignored).
CLAIMS_EXPORT_DIR=var/socialclaims/claims
DATABASE_URL=postgresql://ubuntu:ubuntu@localhost:5432/socialclaims
# knowledge_base (exported JSONL, default) or graph (System A's live store)
SYSTEM_A_SOURCE=knowledge_base
# with SYSTEM_A_SOURCE=bundles: files from `make export-bundles`
SYSTEM_A_BUNDLE_DIR=knowledge_base/bundles
ORIANE_PROJECTION=full
ORIANE_MONTHLY_CREDIT_CEILING=28000
ORIANE_RUN_CREDIT_CEILING=4000
MAX_POSTS_PER_POLITICIAN=1000
DEFAULT_WINDOW_DAYS=90
PLATFORMS=tiktok,instagram
RAW_STORAGE_DIR=var/socialclaims/raw
STORE_RAW_PAYLOADS=true
RAW_RETENTION_DAYS=0
EXCLUDED_FIELDS=profileEmails

# --- System C (Evidence Knowledge Graph, M0) ----------------------------------
EV_EXA_MONTHLY_BUDGET_USD=30

# --- Optional Modal concurrency caps (evaluated by the Modal client at deploy/run time) ---
MODAL_SYSTEMB_MAX_CONTAINERS=1
MODAL_CLAUDE_MAX_CONTAINERS=10
MODAL_SYSTEMC_MAX_CONTAINERS=1
MODAL_FETCH_MAX_CONTAINERS=4
MODAL_TIMEOUT_S=21600
